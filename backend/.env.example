# DiAn 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=xxx
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# api.deepseek.com 的限时客服调用默认关闭思考，避免占满 JSON/正文的输出预算。

# ── 应用 ──────────────────────────────────────────────────────────────────────
# APP_ENV仅控制python api/main.py的开发热重载；鉴权和存储策略读取下方DIAN_ENV。
APP_ENV=production
# Logistics demo fixtures and persistent case database (no real carrier operations).
DIAN_LOGISTICS_DB=data/logistics/cases.sqlite3
# Optional independent mock HTTP ticket service. Start python -m core.mock_ticket_http.
DIAN_TICKET_PROVIDER=sqlite
# Optional external read-only tracking. Bind orders to authenticated users locally.
DIAN_TRACKING_PROVIDER=mock
# KDNIAO_EBUSINESS_ID=
# KDNIAO_API_KEY=
# KDNIAO_ORDER_BINDINGS=data/logistics/external-orders.json
# 8002 endpoint is fixed to https://api.kdniao.com/api/dist; no automatic retries.
# DIAN_TICKET_URL=http://127.0.0.1:18191
# DIAN_TICKET_MOCK_DB=data/logistics/mock-http-tickets.sqlite3
# Optional separate GET-only reconciliation process: python -m core.logistics_reconcile
# DIAN_TICKET_RECONCILE_INTERVAL=10
# DIAN_TICKET_RECONCILE_ALERT_AFTER=300
# Opt-in Temporal logistics execution; run a separate worker with the same logistics DB.
DIAN_TEMPORAL_LOGISTICS=false
DIAN_TEMPORAL_ADDRESS=localhost:7233
# DIAN_LOGISTICS_FIXTURES=config/logistics/fixtures.json
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=dian123
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:dian123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 本地降级路径（仅 development；production 连接失败时中止启动）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# 仅 development 自动导入示例政策；生产空库不会自动添加示例。
DIAN_SEED_DEMO_DOCS=true

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# 单进程容量。聊天总时限包含排队，认证账户上限包含执行中和排队请求。
DIAN_CHAT_TIMEOUT_S=50
DIAN_CHAT_ACTIVE=16
DIAN_CHAT_WAITING=32
DIAN_CHAT_PER_USER=4
DIAN_QUEUE_TIMEOUT_S=2
DIAN_LOGISTICS_ACTIVE=4
DIAN_LOGISTICS_WAITING=8
DIAN_CHAT_MODEL_CALLS=16
DIAN_MODEL_ACTIVE=8
DIAN_MODEL_WAITING=16
DIAN_PROFILE_MODEL_ACTIVE=1
DIAN_PROFILE_MODEL_WAITING=4
DIAN_EVAL_MODEL_ACTIVE=2
DIAN_EVAL_MODEL_WAITING=4

# 每次模型请求的超时（秒）；聊天请求同时受总时限约束。
DIAN_MODEL_TRANSPORT_TIMEOUT_S=30
DIAN_INTENT_TIMEOUT_S=8
DIAN_LLM_TIMEOUT_S=15
DIAN_COMPOSER_TIMEOUT_S=8
# 普通后台画像的最短更新间隔；明确表达偏好时立即更新。设 0 恢复逐轮更新。
PROFILE_UPDATE_MIN_INTERVAL_S=60

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 默认连接无需 Key 的 Microsoft Learn 公开文档 MCP；设 false 可关闭外部连接。
MCP_EXTERNAL_ENABLED=true
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,dian,dian:*,dian-python,dian-python:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
DIAN_ENV=development
# DIAN_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 意图向量：有硅基流动Key时可调用BAAI/bge-m3，无Key使用本地n-gram。
# 不使用Pro/BAAI/bge-m3，不与ANTHROPIC_API_KEY共用；此配置不控制知识库RAG。
# 保留full及物流向量开启，与A1复验后的默认决策一致，不代表已证明三路收益。
# llm_rules是显式对照候选，不是当前默认；已有.env不会被此示例自动覆盖。
INTENT_EMBEDDING_ENABLED=true
INTENT_EMBEDDING_PROVIDER=auto
INTENT_RECOGNITION_MODE=full
INTENT_LOGISTICS_EMBEDDING_ENABLED=true
SILICONFLOW_API_KEY=
